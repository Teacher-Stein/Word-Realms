# ---------------------------------------------------------------------------
# Word Realms — files that must never be committed.
#
# Nothing here is loaded by the game. These are artefacts that computers leave
# behind: Python's compiled cache, Windows and macOS folder metadata, editor
# state. They change constantly, they differ between machines, and they make
# every commit noisier than it should be.
#
# Three .pyc files were already in the repo before this file existed; they are
# deleted in the same commit that adds it.
# ---------------------------------------------------------------------------

# Python bytecode cache — regenerated automatically, never needed
__pycache__/
*.py[cod]
*$py.class

# Operating system clutter
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor and IDE state
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch — anything a build leaves in the working folder
*.log
.cache/
node_modules/
